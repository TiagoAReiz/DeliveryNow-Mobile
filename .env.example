# Copie para .env e ajuste:  cp .env.example .env
# Variáveis EXPO_PUBLIC_* são embutidas no bundle do app (não coloque segredos aqui).

# URL da DeliveryNow API (https://github.com/TiagoAReiz/DeliveryNow-Api)
# - Emulador Android:  http://10.0.2.2:8080
# - Simulador iOS/web: http://localhost:8080
# - Celular físico (Expo Go): http://<IP-da-sua-máquina-na-rede>:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Timeout das requisições em milissegundos
EXPO_PUBLIC_API_TIMEOUT=15000
